# Cloudflare Pages — HTTP-Header pro Pfad
# Doku: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# HTML — kein langes Caching, damit Updates sofort sichtbar sind
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Assets (SVG, og-image) — lang cachen
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# API-Endpunkt — niemals cachen
/api/*
  Cache-Control: no-store

# LLM-Crawler-Hinweise (Quasi-Standard analog robots.txt) — explizit text/plain
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Klassischer robots.txt-MIME absichern (Cloudflare liefert i. d. R. korrekt, aber explizit schadet nicht)
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
